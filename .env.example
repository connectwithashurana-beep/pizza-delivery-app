# Django
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
# Set DEBUG=True only for local development.
DEBUG=False
ALLOWED_HOSTS=your-render-service.onrender.com

# MySQL Database
DB_NAME=pizza_delivery
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=your_mysql_host
DB_PORT=3306

# CORS / Frontend
CORS_ORIGINS=https://your-vercel-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-vercel-app.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app

# Email (SMTP)
# For local development, use: django.core.mail.backends.console.EmailBackend
# For production SMTP, set EMAIL_BACKEND to the SMTP backend explicitly.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com
ADMIN_EMAIL=admin@example.com

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_public_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Redis
REDIS_URL=redis://your-redis-host:6379/0

# Business config
GST_PERCENT=5
DELIVERY_CHARGE=40

# Token expiry (added during audit — these were previously unenforced/unlimited)
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Frontend .env (create frontend/.env separately)
VITE_API_BASE_URL=https://your-render-service.onrender.com/api
VITE_WS_BASE_URL=wss://your-render-service.onrender.com/ws
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key
